# ==============================================================================
# ANANKE LAUNDRY - ZOHO BOOKS INTEGRATION CONFIGURATION
# ==============================================================================
# Fill in the following environment variables to activate live Zoho Books sync.
# To generate credentials:
# 1. Visit the Zoho Developer Console: https://api-console.zoho.com
# 2. Add a 'Server-based Applications' or 'Self Client' app.
# 3. Scope required: ZohoBooks.contacts.ALL, ZohoBooks.estimates.ALL, ZohoBooks.invoices.ALL
# 4. Generate a Refresh Token.
# 5. Locate your Organization ID in Zoho Books (Settings > Organization Profile).
# ==============================================================================

# Zoho OAuth 2.0 Credentials
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Zoho Books Organization ID (Numeric string, e.g. 80001234567)
ZOHO_ORGANIZATION_ID=

# Zoho Data Center Region
# Supported: com (US/Global), in (India), eu (Europe), com.au (Australia)
# Default is 'com'
ZOHO_DC=com

# Admin Security Key
# Required for accessing /admin/zoho management dashboard and sync APIs
ADMIN_SECRET_KEY=ananke_admin_secret_change_me_in_production
