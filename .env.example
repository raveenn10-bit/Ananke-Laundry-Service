# ==============================================================================
# ANANKE LAUNDRY - ZOHO BOOKS READ-ONLY OAUTH INTEGRATION
# ==============================================================================
# 1. Register Server-Based Application in Zoho API Console (https://api-console.zoho.com)
# 2. Set Authorized Redirect URI:
#    https://ananke-laundry-service.vercel.app/api/zoho/callback
# 3. Read-Only Scopes used by /api/zoho/connect:
#    ZohoBooks.contacts.READ
#    ZohoBooks.invoices.READ
#    ZohoBooks.customerpayments.READ
# 4. Visit https://ananke-laundry-service.vercel.app/api/zoho/connect to authenticate.
# ==============================================================================

# Zoho OAuth 2.0 Credentials (Server-side only)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Zoho Books Organization ID (Default: 777888456)
ZOHO_ORGANIZATION_ID=777888456

# Zoho Accounts & API Region
# Supported: com (Global/US), in (India), eu (Europe), com.au (Australia), jp, ca
# Default is 'com'. Accounts server will also be auto-detected from Zoho callback.
ZOHO_DC=com

# Optional custom OAuth callback URL (defaults to https://ananke-laundry-service.vercel.app/api/zoho/callback)
# ZOHO_REDIRECT_URI=https://ananke-laundry-service.vercel.app/api/zoho/callback

# Admin Security Key
ADMIN_SECRET_KEY=ananke_admin_secret_change_me_in_production

